<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.faithflow_bible.ui.home.HomeFragment"
        android:label="@string/ff_nav_home"
        tools:layout="@layout/fragment_home" />

    <!-- The Bible tab is a nested graph so books / chapters / reader stay in one
         back stack, while the bottom bar still highlights the whole tab. -->
    <navigation
        android:id="@+id/navigation_bible"
        app:startDestination="@id/navigation_books">

        <fragment
            android:id="@+id/navigation_books"
            android:name="com.example.faithflow_bible.ui.bible.BooksFragment"
            android:label="@string/ff_nav_bible"
            tools:layout="@layout/fragment_books" />

        <fragment
            android:id="@+id/navigation_chapters"
            android:name="com.example.faithflow_bible.ui.bible.ChaptersFragment"
            android:label="@string/ff_nav_bible"
            tools:layout="@layout/fragment_chapters">
            <argument
                android:name="book"
                android:defaultValue="0"
                app:argType="integer" />
        </fragment>

        <fragment
            android:id="@+id/navigation_reader"
            android:name="com.example.faithflow_bible.ui.reader.ReaderFragment"
            android:label="@string/ff_nav_bible"
            tools:layout="@layout/fragment_reader">
            <argument
                android:name="book"
                android:defaultValue="0"
                app:argType="integer" />
            <argument
                android:name="chapter"
                android:defaultValue="1"
                app:argType="integer" />
            <argument
                android:name="verse"
                android:defaultValue="0"
                app:argType="integer" />
            <!-- Destinations inside this nested graph cannot be referenced by ID
                 from outside it, so the reader is reached via this deep link. -->
            <deepLink app:uri="faithflow://reader/{book}/{chapter}/{verse}" />
        </fragment>
    </navigation>

    <fragment
        android:id="@+id/navigation_saved"
        android:name="com.example.faithflow_bible.ui.favorites.FavoritesFragment"
        android:label="@string/ff_nav_saved"
        tools:layout="@layout/fragment_favorites" />

    <fragment
        android:id="@+id/navigation_notes"
        android:name="com.example.faithflow_bible.ui.notes.NotesFragment"
        android:label="@string/ff_nav_notes"
        tools:layout="@layout/fragment_notes" />

    <fragment
        android:id="@+id/navigation_note_editor"
        android:name="com.example.faithflow_bible.ui.notes.NoteEditorFragment"
        android:label="@string/ff_nav_notes"
        tools:layout="@layout/fragment_note_editor">
        <argument
            android:name="note_id"
            android:defaultValue="0"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/navigation_settings"
        android:name="com.example.faithflow_bible.ui.settings.SettingsFragment"
        android:label="@string/ff_settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/navigation_info"
        android:name="com.example.faithflow_bible.ui.info.InfoFragment"
        android:label="About"
        tools:layout="@layout/fragment_info" />

</navigation>
