<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.FaithflowBible" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ff_primary</item>
        <item name="colorOnPrimary">@color/ff_on_primary</item>
        <item name="colorPrimaryContainer">@color/ff_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/ff_on_primary_container</item>
        <item name="colorSecondaryContainer">@color/ff_primary_container</item>
        <item name="colorOnSecondaryContainer">@color/ff_on_primary_container</item>
        <item name="android:colorBackground">@color/ff_background</item>
        <item name="colorSurface">@color/ff_surface</item>
        <item name="colorSurfaceContainer">@color/ff_surface</item>
        <item name="colorOnSurface">@color/ff_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/ff_text_secondary</item>
        <item name="colorOutline">@color/ff_outline</item>
        <!-- Status bar: deep dark navy, light icons -->
        <item name="android:statusBarColor">#0F1B2A</item>
        <item name="android:navigationBarColor">@color/ff_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>
</resources>
