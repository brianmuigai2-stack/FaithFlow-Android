<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.FaithflowBible" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ff_primary</item>
        <item name="colorOnPrimary">@color/ff_on_primary</item>
        <item name="colorPrimaryContainer">@color/ff_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/ff_on_primary_container</item>
        <item name="colorSecondaryContainer">@color/ff_primary_container</item>
        <item name="colorOnSecondaryContainer">@color/ff_on_primary_container</item>
        <item name="android:colorBackground">@color/ff_background</item>
        <item name="colorSurface">@color/ff_surface</item>
        <item name="colorSurfaceContainer">@color/ff_surface</item>
        <item name="colorOnSurface">@color/ff_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/ff_text_secondary</item>
        <item name="colorOutline">@color/ff_outline</item>
        <!-- Status bar: transparent for edge-to-edge -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.FaithflowBible.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.FaithflowBible.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.FaithflowBible.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
    <style name="Theme.FaithflowBible.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_window</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.FaithflowBible</item>
    </style>

    <!-- Small uppercase heading used above each group on the Settings screen.
         parent="" is required: without it AAPT would look for a Widget.FaithflowBible style. -->
    <style name="Widget.FaithflowBible.SectionHeader" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">@color/ff_text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>